[Desktop Entry]
Type=Application
Name=Orbit
GenericName=Download Manager
Comment=Multi-connection HTTP, BitTorrent and video downloads
Exec=orbit %u
Icon=orbit
Terminal=false
Categories=Network;FileTransfer;
MimeType=x-scheme-handler/orbit;application/x-bittorrent;application/metalink4+xml;application/metalink+xml;x-scheme-handler/magnet;
StartupNotify=true
StartupWMClass=orbit
Keywords=download;torrent;magnet;youtube;
Actions=new-download;pause-all;resume-all;

[Desktop Action new-download]
Name=New Download
Icon=list-add
Exec=orbit new

[Desktop Action pause-all]
Name=Pause All
Icon=media-playback-pause
Exec=orbit pause --all

[Desktop Action resume-all]
Name=Resume All
Icon=media-playback-start
Exec=orbit resume --all
