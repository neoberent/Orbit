# Runs Orbit without a window, for a home server or NAS: control it with the `orbit`
# command or the web dashboard (Settings > Remote in the app, or remote/* in the config).
#
#   systemctl --user enable --now orbit
#   loginctl enable-linger "$USER"     # keep it running while you're logged out
#
# Stop it before opening the normal Orbit window: only one Orbit runs at a time.
[Unit]
Description=Orbit Download Manager (headless)
Documentation=https://github.com/neoberent/Orbit
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=@ORBIT@ --headless
Restart=on-failure
RestartSec=5
# SIGTERM saves torrent resume data and the download list before Orbit exits.
TimeoutStopSec=30
# Orbit (and yt-dlp, ffmpeg, bsdtar it starts) never needs more rights than the user has.
# Only settings that work in a user service without extra kernel features: the stricter
# ones (ProtectSystem, PrivateTmp, ...) need user namespaces and would keep it from starting
# where those are off, and downloads may go anywhere in the home folder.
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
