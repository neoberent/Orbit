#compdef orbit
# zsh completion for orbit (Orbit Download Manager)

_orbit_ids() {
    local -a ids
    ids=(${(f)"$(orbit list 2>/dev/null | awk 'NR > 1 && $1 ~ /^[0-9]+$/ {id=$1; st=$2; $1=$2=$3=$4=$5=""; sub(/^ +/, ""); print id ":" st " " $0}')"})
    _describe 'download' ids
}

_orbit() {
    local -a commands
    commands=(
        'add:Add downloads'
        'list:Show every download'
        'status:Totals and current speeds'
        'pause:Pause downloads'
        'resume:Resume downloads'
        'cancel:Stop unfinished downloads and delete their partial files'
        'remove:Remove downloads from the list'
        'show:Open the window'
        'new:Open the window to add a download'
        'feeds:Torrent RSS feeds'
        'config:Show or change settings'
        'remote:Web dashboard: status, on/off, sign-in'
        'help:Show help'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
        _arguments '--background[start in the tray]' '--headless[run without window or tray]' '--version[print the version]'
        return
    fi
    case ${words[2]} in
        add)
            _arguments '(-d --dir)'{-d,--dir}'[save in this folder]:folder:_directories' \
                       '(-i --input)'{-i,--input}'[add every link in this file]:file:_files' \
                       '--checksum[verify when finished]:checksum:' '--json[print JSON]' \
                       '(-f --force)'{-f,--force}'[add even if downloaded before]' \
                       '*--mirror[another link to the same file]:link:' \
                       '*:link or file:_files -g "*.(torrent|meta4|metalink)"' ;;
        pause|resume|cancel) _arguments '(-a --all)'{-a,--all}'[every download]' '*:download:_orbit_ids' ;;
        remove|rm) _arguments '*:download:_orbit_ids' ;;
        list|ls) _arguments '--json[print JSON]' ;;
        status) _arguments '--json[print JSON]' '(-w --watch)'{-w,--watch}'[keep printing a line whenever it changes]' '--interval[seconds between checks with --watch]:seconds:' ;;
        config) _arguments '1:action:(list get set)' '2:setting:(${(f)"$(orbit config list --json 2>/dev/null | sed -n "s/.*\"name\": \"\\([^\"]*\\)\".*/\\1/p")"})' '--json[print JSON]' ;;
        remote) _arguments '1:action:(status enable disable set-password)' '--json[print JSON]' ;;
        feeds) _arguments '1:action:(add remove check)' '--filter[words a title must contain]:words:' '(-d --dir)'{-d,--dir}'[save in this folder]:folder:_directories' '--json[print JSON]' ;;
    esac
}

_orbit "$@"
