# Maintainer: Neo Berent <neo.berent1@gmail.com>
#
# The Orbit browser extension, unpacked for Chromium-based browsers and Firefox.
# installer/aur/update-aur.sh bumps pkgver, _tag and the checksum for each release.

pkgname=orbit-download-manager-extension
pkgver=1.3.0
pkgrel=1
_tag=Release3.1.2
pkgdesc='Browser extension that sends downloads, videos and magnet links to Orbit Download Manager'
arch=('any')
url='https://github.com/neoberent/Orbit'
license=('MIT')
depends=('orbit-download-manager')
install=orbit-download-manager-extension.install
source=("https://github.com/neoberent/Orbit-release/releases/download/$_tag/orbit-extension-$pkgver.zip"
        'orbit-extension')
noextract=("orbit-extension-$pkgver.zip")
sha256sums=('d7a79ed9895042a225b3909121ba5ec4fa7382aaef03e0dc59c6b6cb6263ae3d'
            '69941aaf9a78992d1c50838854897c04356fb18817256c2a1fc212c2ff2085e0')

prepare() {
    rm -rf chromium firefox
    mkdir chromium firefox
    bsdtar -xf "orbit-extension-$pkgver.zip" -C chromium
    bsdtar -xf "orbit-extension-$pkgver.zip" -C firefox
    rm chromium/manifest.firefox.json
    mv -f firefox/manifest.firefox.json firefox/manifest.json
}

package() {
    local share="$pkgdir/usr/share/orbit-download-manager/extension"
    install -dm755 "$share"
    cp -r --no-preserve=ownership chromium firefox "$share/"
    find "$share" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +

    install -Dm755 orbit-extension "$pkgdir/usr/bin/orbit-extension"
    install -Dm644 chromium/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
